POSTGRES_PASSWORD=changeme
JWT_SECRET=changeme
# 프런트엔드 도메인이 정해지면 * 대신 그 주소로 좁히세요 (예: https://haru.example.com)
CORS_ORIGIN=*

# 문자 인증: test(화면에 인증번호 표시) | solapi(실제 문자)
SMS_PROVIDER=test
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER=

# 하루 한수 플러스 자동결제(토스페이먼츠 API 개별 연동 키). 비우면 구독 기능이 꺼진다
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
