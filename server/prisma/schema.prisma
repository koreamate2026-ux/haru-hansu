// 하루 한수 API — ERD 문서(설계서)의 to-be 구조를 그대로 옮긴 Prisma 스키마
// household.md 문서 참고: Account, Household, Person 세 층으로 나눠 여러 사람이
// 같은 가족 데이터를 공유할 수 있게 한다.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id              String    @id @default(uuid())
  /// 로그인 아이디(예전에는 이메일). 칸 이름을 바꾸면 db push가 데이터를 지우므로 그대로 둔다
  email           String    @unique
  passwordHash    String
  displayName     String
  /// 010으로 시작하는 숫자만(하이픈 없이). 휴대폰 인증을 거친 계정만 값이 있다
  phone           String?   @unique
  phoneVerifiedAt DateTime?
  createdAt       DateTime  @default(now())

  memberships      HouseholdMember[]
  ownedHouseholds  Household[]        @relation("HouseholdOwner")
  createdTickets   SavedTicket[]
  subscription     Subscription?
  favorites        FavoritePerson[]

  @@map("accounts")
}

/// 좋아하는 연예인·위인(플러스 전용, 계정마다). 나와의 궁합 숫자를 보는 데 쓴다
model FavoritePerson {
  id            String   @id @default(uuid())
  accountId     String
  name          String
  /// historical(앱이 준 위인 목록) | custom(사용자가 직접 입력)
  kind          String   @default("custom")
  historicalKey String?
  calendar      Calendar @default(solar)
  leapMonth     Boolean  @default(false)
  birthYear     Int
  birthMonth    Int
  birthDay      Int
  birthHour     Int?
  birthMinute   Int      @default(0)
  createdAt     DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("favorite_people")
}

/// 하루 한수 플러스 구독. 계정(개인) 단위로 하나. 결제 전에도 customerKey를 담아 두려고 pending 상태로 먼저 만든다
model Subscription {
  id                String    @id @default(uuid())
  accountId         String    @unique
  /// 토스 자동결제용 구매자 ID. 추측할 수 없게 무작위로 만든다
  customerKey       String    @unique
  /// monthly | yearly
  plan              String    @default("monthly")
  /// 다음 갱신부터 바꿀 요금제. 갱신 때 plan으로 옮기고 비운다
  nextPlan          String?
  /// pending(카드 등록 전) | active | past_due(갱신 결제 실패, 재시도 중) | expired
  status            String    @default("pending")
  /// 암호화해서 저장(lib/secretBox.ts)
  billingKey        String?
  /// 첫 결제 요청을 보내기 직전에 적어 두는 주문번호. 서버가 중간에 멈춰도 이걸로 결제 여부를 되짚는다
  pendingOrderId    String?
  /// 갱신 전 안내 문자를 보낸 기간(currentPeriodEnd). 같은 기간에 두 번 보내지 않도록
  renewalNoticeFor  DateTime?
  currentPeriodEnd  DateTime?
  cancelAtPeriodEnd Boolean   @default(false)
  failedAttempts    Int       @default(0)
  lastAttemptAt     DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  account  Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  payments SubscriptionPayment[]

  @@map("subscriptions")
}

/// 결제 기록은 법에 따라 5년 보관해야 해서, 회원이 탈퇴해 구독이 지워져도 남긴다(subscriptionId만 비움)
model SubscriptionPayment {
  id             String   @id @default(uuid())
  subscriptionId String?
  /// 같은 기간을 두 번 청구하지 않도록 기간마다 고정된 주문번호
  orderId        String   @unique
  plan           String
  amount         Int
  /// paid | failed | refunded | partially_refunded
  status         String
  refundedAmount Int      @default(0)
  paymentKey     String?
  failReason     String?
  periodStart    DateTime
  periodEnd      DateTime
  createdAt      DateTime @default(now())

  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@map("subscription_payments")
}

model Household {
  id        String   @id @default(uuid())
  name      String
  ownerId   String
  owner     Account  @relation("HouseholdOwner", fields: [ownerId], references: [id])
  createdAt DateTime @default(now())

  members       HouseholdMember[]
  persons       Person[]
  familyEvents  FamilyEvent[]
  tickets       SavedTicket[]
  settings      HouseholdSettings?
  invites       HouseholdInvite[]

  @@map("households")
}

/// 가족 그룹 초대 코드. 그룹을 만든 사람만 만들 수 있고, 7일 동안 한 번만 쓸 수 있다
model HouseholdInvite {
  id          String    @id @default(uuid())
  code        String    @unique
  householdId String
  createdById String
  /// 누구를 초대했는지(그룹에 이미 등록된 사람). 참여하면 그 사람과 연결하도록 미리 골라 둔다
  personId    String?
  expiresAt   DateTime
  usedById    String?
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@map("household_invites")
}

enum MemberRole {
  owner
  member
}

model HouseholdMember {
  id          String     @id @default(uuid())
  householdId String
  accountId   String
  role        MemberRole @default(member)
  joinedAt    DateTime   @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([householdId, accountId])
  @@map("household_members")
}

enum Calendar {
  solar
  lunar
}

enum BloodType {
  A
  B
  O
  AB
}

model Person {
  id          String    @id @default(uuid())
  householdId String
  name        String
  calendar    Calendar  @default(solar)
  leapMonth   Boolean   @default(false)
  birthYear   Int
  birthMonth  Int
  birthDay    Int
  /// null이면 태어난 시간을 모름
  birthHour   Int?
  birthMinute Int       @default(0)
  bloodType   BloodType?
  /// M | F. 10년 운(대운) 계산에만 쓰고, 모르면 null
  gender      String?
  /// 이 사람이 곧 그룹의 어느 계정 본인인지(가족 연동). 그룹 안에서 한 계정은 한 사람에게만 연결된다
  linkedAccountId    String?
  /// 등록한 계정. 지우기 권한 판단용(예전 데이터는 비어 있음)
  createdByAccountId String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  household     Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  dailyDreams   DailyDream[]
  ticketPersons TicketPerson[]
  familyEvents  FamilyEvent[]

  @@unique([householdId, linkedAccountId])
  @@map("persons")
}

model FamilyEvent {
  id          String @id @default(uuid())
  householdId String
  personId    String
  label       String
  month       Int
  day         Int

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  person    Person    @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@map("family_events")
}

model DailyDream {
  id       String @id @default(uuid())
  personId String
  /// YYYY-MM-DD (KST 기준)
  date     String
  dreamKey String

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([personId, date])
  @@map("daily_dreams")
}

model SavedTicket {
  id              String   @id @default(uuid())
  householdId     String
  /// zodiac | ohaeng | compat | star | blood | stone | dream | family | name | today | lucky | manual
  category        String
  round           Int
  numbers         Int[]
  source          String   @default("saju")
  createdByAccountId String?
  createdAt       DateTime @default(now())

  household       Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy       Account?       @relation(fields: [createdByAccountId], references: [id])
  ticketPersons   TicketPerson[]

  @@map("saved_tickets")
}

model TicketPerson {
  ticketId String
  personId String

  ticket SavedTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  person Person      @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([ticketId, personId])
  @@map("ticket_persons")
}

model DrawResult {
  round     Int      @id
  date      String
  numbers   Int[]
  bonus     Int
  source    String   @default("api")
  fetchedAt DateTime @default(now())

  @@map("draw_results")
}

model HouseholdSettings {
  householdId String  @id
  drawApiBase String  @default("")

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@map("household_settings")
}
